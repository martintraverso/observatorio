{
	"name": "observatorio-uruguay-app",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"datos": "node scripts/preparar-datos.mjs",
		"predev": "node scripts/preparar-datos.mjs",
		"dev": "vite dev",
		"prebuild": "node scripts/preparar-datos.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo \"\"",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test:unit": "vitest --run",
		"test:e2e": "playwright test",
		"test": "npm run test:unit && npm run test:e2e",
		"test:lighthouse": "node scripts/lighthouse.mjs"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@fontsource/inter": "5.3.0",
		"@fontsource/space-grotesk": "5.3.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "24.19.2",
		"lighthouse": "13.6.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"maplibre-gl": "6.19.0",
		"pmtiles": "4.5.0"
	}
}
